# Ignore everything
*

# Keep this file
!.gitignore

# Track README.md
!README.md

# Track deployment folder
!deployment/
!deployment/**

# Track sdcli-scripts folder
!sdcli-scripts/
!sdcli-scripts/**

# Track project design and implementation documents
!docs/
!docs/**

# Never track backup files
*.bak
**/*.bak

# Never track macOS metadata
.DS_Store
**/.DS_Store
