# Ignore everything
*

# Keep this file
!.gitignore

# Track README.md
!README.md

# Track deployment folder
!deployment/
!deployment/**

# Track the offline release script.
!release/
!release/**

# Docker must receive only the Dockerfile build input. Vendor RPMs and
# customer configuration cannot enter the image build context.
!.dockerignore

# Track sdcli-scripts folder
!sdcli-scripts/
!sdcli-scripts/**
sdcli-scripts/**/__pycache__/
sdcli-scripts/**/*.pyc

# Track this feature's design and implementation documents
!docs/
!docs/superpowers/
!docs/superpowers/specs/
!docs/superpowers/specs/2026-10-09-offline-container-distribution-design.md
!docs/superpowers/specs/2026-10-16-automatic-migration-validation-report-design.md
!docs/superpowers/specs/2026-10-17-actionable-validation-evidence-design.md
!docs/superpowers/specs/2026-10-19-parser-risk-remediation-design.md
!docs/superpowers/plans/
!docs/superpowers/plans/2026-10-09-offline-container-distribution.md
!docs/superpowers/plans/2026-10-16-automatic-migration-validation-report.md
!docs/superpowers/plans/2026-10-19-parser-risk-remediation.md
!docs/tech-debt-multi-source-adapters.md

# Track the migration reliability review and mandatory-change design.
!docs/migration-reliability-priorities.md
!docs/migration-reliability-design.md

# Track regression tests for the mandatory migration reliability fixes.
!tests/
!tests/sdcli_error_exit_test.sh
!tests/sdcli_success_marker_test.sh
!tests/sdcli_success_marker_error_test.sh
!tests/sdcli_conversion_diagnostic_test.sh
