#!/usr/bin/env bash
set -euo pipefail

REAL_BCP="${SQLSERVER_REAL_BCP:-}"
if [[ -n "$REAL_BCP" && ! -x "$REAL_BCP" ]]; then
  echo "ERROR: configured bcp binary is not executable: $REAL_BCP" >&2
  exit 127
fi

if [[ -z "$REAL_BCP" ]]; then
  for cand in /opt/mssql-tools18/bin/bcp /opt/mssql-tools/bin/bcp; do
    if [[ -x "$cand" ]]; then
      REAL_BCP="$cand"
      break
    fi
  done
fi

if [[ -z "$REAL_BCP" ]]; then
  echo "ERROR: real bcp binary not found" >&2
  exit 127
fi

MODE="${SQLSERVER_BCP_TLS_MODE_EFFECTIVE:-trust}"
PACKET_SIZE="${SQLSERVER_BCP_PACKET_SIZE:-}"
BCP_PASSWORD="${SQLSERVER_BCP_PASSWORD:-}"
BCP_STATUS_FILE="${SQLSERVER_BCP_STATUS_FILE:-}"
BCP_SOURCE_DATABASE="${SQLSERVER_BCP_SOURCE_DATABASE:-}"
BCP_TABLE_CATALOG_FILE="${SQLSERVER_BCP_TABLE_CATALOG_FILE:-}"
BCP_ADJUSTMENTS_FILE="${SQLSERVER_BCP_ADJUSTMENTS_FILE:-}"

bcp_option_value() {
  local option="$1"
  local index argument
  for ((index = 0; index < ${#args[@]}; index++)); do
    argument="${args[$index]}"
    if [[ "$argument" == "$option" ]]; then
      (( index + 1 < ${#args[@]} )) || return 1
      printf '%s' "${args[$((index + 1))]}"
      return 0
    fi
    if [[ "$argument" == "$option"?* ]]; then
      printf '%s' "${argument#"$option"}"
      return 0
    fi
  done
  return 1
}

bcp_ascii_lower() {
  LC_ALL=C tr '[:upper:]' '[:lower:]'
}

load_bcp_table_catalog() {
  local server username raw_file
  local -a sqlcmd_tls_args=()
  [[ -n "$BCP_TABLE_CATALOG_FILE" ]] || {
    echo 'ERROR: source table catalog path is missing; install matching migrate.sh and lib/bcp' >&2
    return 1
  }
  [[ ! -s "$BCP_TABLE_CATALOG_FILE" ]] || return 0
  server="$(bcp_option_value -S)" || {
    echo 'ERROR: cannot resolve a dotted SQL Server table name: bcp server option is missing' >&2
    return 1
  }
  username="$(bcp_option_value -U)" || {
    echo 'ERROR: cannot resolve a dotted SQL Server table name: bcp SQL authentication user is missing' >&2
    return 1
  }
  [[ -n "$BCP_PASSWORD" ]] || {
    echo 'ERROR: cannot resolve a dotted SQL Server table name: source password is unavailable' >&2
    return 1
  }

  case "$MODE" in
    strict) sqlcmd_tls_args=(-Ns) ;;
    trust) sqlcmd_tls_args=(-Nm -C) ;;
    optional) sqlcmd_tls_args=(-No) ;;
    *)
      echo "ERROR: unsupported BCP TLS mode while resolving dotted SQL Server table name: $MODE" >&2
      return 1
      ;;
  esac

  raw_file="$(mktemp "${BCP_TABLE_CATALOG_FILE}.XXXXXX")" || return 1
  # One catalog query per offload attempt, on first ambiguous export only.
  # QUOTENAME supplies escaped SQL identifiers; no identifier is split on dots.
  # Unlimited column width and an end marker preserve long/trailing-space names.
  if ! SQLCMDPASSWORD="$BCP_PASSWORD" sqlcmd \
    -S "$server" -U "$username" -d "$BCP_SOURCE_DATABASE" \
    -h -1 -y 0 -w 65535 -f 65001 -b -r 1 -x "${sqlcmd_tls_args[@]}" \
    -Q "SET NOCOUNT ON;
SELECT CAST(N'SDCLI_BCP_TABLE' AS nvarchar(max)) + NCHAR(9)
     + s.name + N'.' + o.name + NCHAR(9)
     + QUOTENAME(DB_NAME()) + N'.' + QUOTENAME(s.name) + N'.' + QUOTENAME(o.name)
     + NCHAR(9) + N'SDCLI_END'
FROM sys.objects AS o JOIN sys.schemas AS s ON s.schema_id = o.schema_id
WHERE o.type IN ('U', 'V') AND o.is_ms_shipped = 0;" > "$raw_file"; then
    rm -f "$raw_file"
    echo 'ERROR: SQL Server source table catalog query failed' >&2
    return 1
  fi
  if ! awk -F '\t' -v OFS='\t' '
    /^[[:space:]]*$/ { next }
    { sub(/\r$/, "") }
    NF != 4 || $1 != "SDCLI_BCP_TABLE" || $2 == "" || $3 == "" || $4 !~ /^SDCLI_END *$/ { invalid=1; next }
    { print $2, $3; rows++ }
    END { if (invalid || rows == 0) exit 1 }
  ' "$raw_file" > "$raw_file.parsed"; then
    rm -f "$raw_file" "$raw_file.parsed"
    echo 'ERROR: source table catalog is empty or malformed; names with tab/newline characters are unsupported' >&2
    return 1
  fi
  mv "$raw_file.parsed" "$BCP_TABLE_CATALOG_FILE" || { rm -f "$raw_file" "$raw_file.parsed"; return 1; }
  rm -f "$raw_file"
}

resolve_dotted_bcp_table() {
  local source_object="$1" mode source_prefix source_suffix
  local source_object_folded source_prefix_folded key qualified resolved="" count=0
  mode="$(printf '%s' "${args[1]:-}" | bcp_ascii_lower)"
  [[ "$mode" == out && -n "$BCP_SOURCE_DATABASE" ]] || return 0
  source_prefix="${BCP_SOURCE_DATABASE}."
  source_object_folded="$(printf '%s' "$source_object" | bcp_ascii_lower)"
  source_prefix_folded="$(printf '%s' "$source_prefix" | bcp_ascii_lower)"
  [[ "$source_object_folded" == "$source_prefix_folded"* ]] || return 0
  source_suffix="${source_object:${#source_prefix}}"
  [[ "$BCP_SOURCE_DATABASE" == *.* || "$source_suffix" == *.*.* ]] || return 0

  load_bcp_table_catalog || return 1
  while IFS=$'\t' read -r key qualified; do
    if [[ "$key" == "$source_suffix" ]]; then
      resolved="$qualified"
      count=$((count + 1))
    fi
  done < "$BCP_TABLE_CATALOG_FILE"
  if (( count != 1 )); then
    echo "ERROR: dotted SQL Server table name must resolve to exactly one schema/table: $source_object (matches=$count)" >&2
    return 1
  fi
  args[0]="SELECT * FROM $resolved"
  args[1]=queryout
  printf '[SDCLI-BCP-ADAPT] runtime out -> queryout: %s -> %s; generated scripts unchanged\n' "$source_object" "${args[0]}"
  if [[ -n "$BCP_ADJUSTMENTS_FILE" ]]; then
    printf '%s\t%s\t%s\n' "$source_object" "$bcp_data_file" "${args[0]}" >> "$BCP_ADJUSTMENTS_FILE" || return 1
  fi
}

args=()
has_u=0
has_Y=0
has_a=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -a)
      has_a=1
      args+=("$1")
      shift
      if [[ $# -gt 0 ]]; then
        args+=("$1")
        shift
      fi
      ;;
    -a*)
      has_a=1
      args+=("$1")
      shift
      ;;
    -P)
      shift
      if [[ -n "$BCP_PASSWORD" ]]; then
        if [[ $# -gt 0 ]]; then
          shift
        fi
      else
        args+=("-P")
        if [[ $# -gt 0 ]]; then
          args+=("$1")
          shift
        fi
      fi
      ;;
    -P*)
      if [[ -z "$BCP_PASSWORD" ]]; then
        args+=("$1")
      fi
      shift
      ;;
    -u)
      has_u=1
      args+=("$1")
      shift
      ;;
    -Y)
      has_Y=1
      args+=("$1")
      shift
      if [[ $# -gt 0 ]]; then
        args+=("$1")
        shift
      fi
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

case "$MODE" in
  strict)
    if [[ $has_Y -eq 0 ]]; then
      args+=("-Ys")
    fi
    ;;
  trust)
    if [[ $has_Y -eq 0 ]]; then
      args+=("-Ym")
    fi
    if [[ $has_u -eq 0 ]]; then
      args+=("-u")
    fi
    ;;
  optional)
    if [[ $has_Y -eq 0 ]]; then
      args+=("-Yo")
    fi
    ;;
esac

if [[ -n "$PACKET_SIZE" && $has_a -eq 0 ]]; then
  args+=("-a" "$PACKET_SIZE")
fi

bcp_object="${args[0]:-}"
bcp_data_file=""
for ((arg_idx = 0; arg_idx + 1 < ${#args[@]}; arg_idx++)); do
  case "${args[$arg_idx]}" in
    [Oo][Uu][Tt]|[Qq][Uu][Ee][Rr][Yy][Oo][Uu][Tt])
      bcp_data_file="${args[$((arg_idx + 1))]}"
      [[ "$bcp_data_file" == /* || "$bcp_data_file" == "-" ]] || bcp_data_file="$PWD/$bcp_data_file"
      break
      ;;
  esac
done

if ! resolve_dotted_bcp_table "$bcp_object"; then
  if [[ -n "$BCP_STATUS_FILE" ]]; then
    printf '2\t%s\t%s\t\n' "$bcp_object" "$bcp_data_file" >> "$BCP_STATUS_FILE"
  fi
  exit 2
fi

if [[ -n "$BCP_STATUS_FILE" ]]; then
  if [[ -z "$bcp_object" || -z "$bcp_data_file" || "$bcp_data_file" == "-" ]]; then
    echo "ERROR: bcp export arguments do not identify one source object/query and external data file" >&2
    exit 2
  fi
  case "$bcp_object$bcp_data_file" in
    *$'\t'*|*$'\r'*|*$'\n'*)
      echo "ERROR: bcp structured evidence does not support control characters in object/query or data-file arguments" >&2
      exit 2
      ;;
  esac
  printf '[SDCLI-BCP-OBJECT] %s\n' "$bcp_object"
fi

output_file="$(mktemp "${TMPDIR:-/tmp}/sdcli_bcp_output_XXXXXX")"
trap 'rm -f "$output_file"' EXIT

if [[ -n "$BCP_PASSWORD" ]]; then
  unset SQLSERVER_BCP_PASSWORD
  set +e
  printf '%s\n' "$BCP_PASSWORD" | "$REAL_BCP" "${args[@]}" 2>&1 | tee "$output_file"
  rc=${PIPESTATUS[1]}
  set -e
else
  set +e
  "$REAL_BCP" "${args[@]}" 2>&1 | tee "$output_file"
  rc=${PIPESTATUS[0]}
  set -e
fi

if [[ -n "$BCP_STATUS_FILE" ]]; then
  bcp_rows="$(sed -nE 's/^[[:space:]]*([0-9]+)[[:space:]]+rows[[:space:]]+copied\..*/\1/p' "$output_file" | tail -n 1)"
  printf '%s\t%s\t%s\t%s\n' "$rc" "$bcp_object" "$bcp_data_file" "$bcp_rows" >> "$BCP_STATUS_FILE"
fi

exit "$rc"
