#!/usr/bin/env bash
set -euo pipefail

find_real_sqlldr() {
  local configured="${ORACLE_REAL_SQLLDR:-${SQLLDR_REAL:-}}"
  if [[ -n "$configured" ]]; then
    [[ -x "$configured" ]] || {
      echo "ERROR: configured sqlldr binary is not executable: $configured" >&2
      exit 127
    }
    printf '%s\n' "$configured"
    return 0
  fi

  local self_dir self_path path_dir cand cand_dir cand_path
  self_dir="$(cd "$(dirname "$0")" && pwd -P)"
  self_path="$self_dir/$(basename "$0")"

  local IFS=:
  for path_dir in $PATH; do
    [[ -n "$path_dir" ]] || path_dir="."
    cand="$path_dir/sqlldr"
    [[ -x "$cand" ]] || continue
    cand_dir="$(cd "$(dirname "$cand")" && pwd -P)" || continue
    cand_path="$cand_dir/$(basename "$cand")"
    [[ "$cand_path" == "$self_path" ]] && continue
    printf '%s\n' "$cand_path"
    return 0
  done

  echo "ERROR: real sqlldr binary not found" >&2
  exit 127
}

upper() {
  printf '%s\n' "$1" | tr '[:lower:]' '[:upper:]'
}

strip_outer_quotes() {
  local value="$1"
  value="${value%\"}"
  value="${value#\"}"
  value="${value%\'}"
  value="${value#\'}"
  printf '%s\n' "$value"
}

strip_password_from_userid() {
  local userid
  userid="$(strip_outer_quotes "$1")"

  local slash_pos=0 at_pos=0 i char
  for ((i = 0; i < ${#userid}; i++)); do
    if [[ "${userid:i:1}" == "/" ]]; then
      slash_pos=$((i + 1))
      break
    fi
  done

  if (( slash_pos == 0 )); then
    printf '%s\n' "$userid"
    return 0
  fi

  for ((i = ${#userid} - 1; i >= slash_pos; i--)); do
    char="${userid:i:1}"
    if [[ "$char" == "@" ]]; then
      at_pos=$((i + 1))
      break
    fi
  done

  if (( at_pos > slash_pos )); then
    printf '%s%s\n' "${userid:0:slash_pos - 1}" "${userid:at_pos - 1}"
  else
    printf '%s\n' "$userid"
  fi
}

is_named_arg() {
  [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]
}

control_arg() {
  local arg lower
  for arg in "$@"; do
    lower="$(upper "$arg")"
    if [[ "$lower" == CONTROL=* ]]; then
      printf '%s\n' "${arg#*=}"
      return 0
    fi
  done
  printf '\n'
}

named_arg_value() {
  local wanted arg upper_arg
  wanted="$(upper "$1")="
  shift
  for arg in "$@"; do
    upper_arg="$(upper "$arg")"
    if [[ "$upper_arg" == "$wanted"* ]]; then
      strip_outer_quotes "${arg#*=}"
      return 0
    fi
  done
  printf '\n'
}

absolute_runtime_path() {
  local value="$1"
  value="$(strip_outer_quotes "$value")"
  [[ -n "$value" && "$value" != "-" ]] || {
    printf '%s\n' "$value"
    return 0
  }
  if [[ "$value" == /* ]]; then
    printf '%s\n' "$value"
  else
    printf '%s/%s\n' "$PWD" "$value"
  fi
}

CONTROL_TABLE_NAME=""
CONTROL_DATA_FILE=""

parse_control_file_metadata() {
  local control_file="$1"
  [[ -f "$control_file" ]] || {
    echo "ERROR: SQL*Loader control file not found: $control_file" >&2
    return 2
  }

  local records kind value first last inner
  local identifier_part qualified_identifier
  records="$(LC_ALL=C awk -v control_file="$control_file" '
    toupper($1) == "INFILE" {
      infile_count++
      value=$0
      sub(/^[[:space:]]*[Ii][Nn][Ff][Ii][Ll][Ee][[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      print "INFILE\t" value
    }
    toupper($1) == "INTO" && toupper($2) == "TABLE" {
      table_count++
      value=$0
      sub(/^[[:space:]]*[Ii][Nn][Tt][Oo][[:space:]]+[Tt][Aa][Bb][Ll][Ee][[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      print "TABLE\t" value
    }
    END {
      failed=0
      if (infile_count != 1) {
        printf "ERROR: SQL*Loader control file must contain exactly one INFILE record; found %d: %s\n", infile_count+0, control_file > "/dev/stderr"
        failed=1
      }
      if (table_count != 1) {
        printf "ERROR: SQL*Loader control file must contain exactly one INTO TABLE record; found %d: %s\n", table_count+0, control_file > "/dev/stderr"
        failed=1
      }
      if (failed) exit 2
    }
  ' "$control_file")" || return 2

  CONTROL_TABLE_NAME=""
  CONTROL_DATA_FILE=""
  while IFS=$'\t' read -r kind value; do
    case "$kind" in
      INFILE) CONTROL_DATA_FILE="$value" ;;
      TABLE) CONTROL_TABLE_NAME="$value" ;;
    esac
  done <<< "$records"

  [[ -n "$CONTROL_DATA_FILE" ]] || {
    echo "ERROR: SQL*Loader INFILE value is empty: $control_file" >&2
    return 2
  }
  first="${CONTROL_DATA_FILE:0:1}"
  last="${CONTROL_DATA_FILE:${#CONTROL_DATA_FILE}-1:1}"
  if [[ "$first" == "'" || "$first" == '"' ]]; then
    [[ "$last" == "$first" && ${#CONTROL_DATA_FILE} -ge 2 ]] || {
      echo "ERROR: SQL*Loader INFILE path has unmatched quotes: $control_file" >&2
      return 2
    }
    inner="${CONTROL_DATA_FILE:1:${#CONTROL_DATA_FILE}-2}"
    [[ -n "$inner" && "$inner" != *"$first"* ]] || {
      echo "ERROR: SQL*Loader INFILE path uses an unsupported quoted value: $control_file" >&2
      return 2
    }
    CONTROL_DATA_FILE="$inner"
  else
    if [[ "$CONTROL_DATA_FILE" == *[[:space:]]* || "$CONTROL_DATA_FILE" == *"'"* || "$CONTROL_DATA_FILE" == *'"'* ]]; then
      echo "ERROR: SQL*Loader INFILE path uses an unsupported value: $control_file" >&2
      return 2
    fi
  fi
  [[ "$CONTROL_DATA_FILE" != "*" && "$CONTROL_DATA_FILE" != "-" ]] || {
    echo "ERROR: SQL*Loader INFILE must reference one external data file: $control_file" >&2
    return 2
  }

  identifier_part='([A-Za-z][A-Za-z0-9_$#]*|"([^"]|"")+")'
  qualified_identifier="^${identifier_part}(\\.${identifier_part})?$"
  if [[ ! "$CONTROL_TABLE_NAME" =~ $qualified_identifier ]]; then
    echo "ERROR: SQL*Loader control file has an unsupported INTO TABLE identifier: $control_file" >&2
    return 2
  fi
}

log_count() {
  local log_file="$1"
  local kind="$2"
  [[ -f "$log_file" ]] || {
    printf '\n'
    return 0
  }
  case "$kind" in
    loaded)
      awk '/Rows successfully loaded\./ {sum += $1; found=1} END {if (found) print sum}' "$log_file"
      ;;
    rejected)
      awk '/^Total logical records rejected:/ {sum += $NF; found=1} END {if (found) print sum}' "$log_file"
      ;;
    discarded)
      awk '/^Total logical records discarded:/ {sum += $NF; found=1} END {if (found) print sum}' "$log_file"
      ;;
  esac
}

sqlldr_password() {
  local fd="${SDCLI_LOAD_PASSWORD_FD:-}" password=""
  if [[ -n "$fd" ]]; then
    IFS= read -r password <&"$fd" || password=""
  fi
  printf '%s\n' "$password"
}

REAL_SQLLDR="$(find_real_sqlldr)"

args=()
userid_seen=0
while [[ $# -gt 0 ]]; do
  arg="$1"
  lower="$(upper "$arg")"
  case "$lower" in
    DIRECT=*|ROWS=*|BINDSIZE=*|READSIZE=*|MULTITHREADING=*)
      ;;
    USERID=*)
      args+=("userid=$(strip_password_from_userid "${arg#*=}")")
      userid_seen=1
      ;;
    *)
      if [[ $userid_seen -eq 0 ]] && ! is_named_arg "$arg"; then
        args+=("userid=$(strip_password_from_userid "$arg")")
        userid_seen=1
      else
        args+=("$arg")
      fi
      ;;
  esac
  shift
done

direct="$(upper "${SDCLI_SQLLDR_DIRECT:-FALSE}")"
args+=("DIRECT=$direct")
args+=("ROWS=${SDCLI_SQLLDR_ROWS:-50000}")
args+=("BINDSIZE=${SDCLI_SQLLDR_BINDSIZE:-16777216}")
args+=("READSIZE=${SDCLI_SQLLDR_READSIZE:-16777216}")
if [[ "$direct" == "TRUE" ]]; then
  args+=("MULTITHREADING=TRUE")
fi

control="$(control_arg "${args[@]}")"
control="$(strip_outer_quotes "$control")"
control_file="$(absolute_runtime_path "$control")"
parse_control_file_metadata "$control_file" || exit 2
target_table="$CONTROL_TABLE_NAME"
data_file="$(absolute_runtime_path "$CONTROL_DATA_FILE")"
log_file="$(absolute_runtime_path "$(named_arg_value LOG "${args[@]}")")"
if [[ -z "$log_file" && -n "$control_file" ]]; then
  log_file="${control_file%.*}.log"
fi
start_ts=$SECONDS

set +e
printf '%s\n' "$(sqlldr_password)" | "$REAL_SQLLDR" "${args[@]}"
rc=${PIPESTATUS[1]}
set -e

echo "[SQLLDR-SUMMARY] control=$control elapsed_sec=$((SECONDS - start_ts)) rc=$rc"

if [[ -n "${ORACLE_SQLLDR_STATUS_FILE:-}" ]]; then
  loaded_rows="$(log_count "$log_file" loaded)"
  rejected_rows="$(log_count "$log_file" rejected)"
  discarded_rows="$(log_count "$log_file" discarded)"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$rc" "$target_table" "$control_file" "$data_file" \
    "$loaded_rows" "$rejected_rows" "$discarded_rows" "$log_file" >> "$ORACLE_SQLLDR_STATUS_FILE"
fi
exit "$rc"
